# Anthropic API Key — necessaria per l'analisi AI
# Ottienila su: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Notion Integration — necessaria per l'archivio aste
# Crea un'integrazione su: https://www.notion.so/my-integrations
# Poi condividi il database "Archivio Aste" con l'integrazione
NOTION_API_KEY=your_notion_api_key_here
# ID del database Notion (già preconfigurato con il DB creato)
NOTION_DATABASE_ID=8fec6ff382da43db974688a1d871221f
